# Copy to terraform.tfvars and fill in.
# Use forward slashes (/) in paths, also on Windows.

# --- VMware Workstation -------------------------------------------------------
template_vmx = "C:/VMs/templates/ubuntu-2604-template/ubuntu-2604-template.vmx"
vm_directory = "C:/VMs"
# vmrun_path        = "C:/Program Files (x86)/VMware/VMware Workstation/vmrun.exe"
# vdiskmanager_path = "C:/Program Files (x86)/VMware/VMware Workstation/vmware-vdiskmanager.exe"
start_gui = false

# --- Network ---------------------------------------------------------------
vms = {
  "kube-cp01" = { ip = "192.168.80.101", role = "control_plane" }
  "kube-cp02" = { ip = "192.168.80.102", role = "control_plane" }
  "kube-cp03" = { ip = "192.168.80.103", role = "control_plane" }
  "kube-wl01" = { ip = "192.168.80.111", role = "worker" }
  "kube-wl02" = { ip = "192.168.80.112", role = "worker" }
  # Example of a per-VM override:
  "kube-wl03" = { ip = "192.168.80.113", role = "worker", cpu = 4, memory_mb = 8192, disk_gb = 100 }
}
ip_prefix_length = 24
gateway          = "192.168.80.2" # vmnet8 (NAT) uses .2 as gateway
dns_servers      = ["192.168.80.2", "1.1.1.1"]
dns_domain       = "lab.local"

# --- Login (SSH is always enabled with password) ----------------------
vm_username     = "ubuntu"
vm_password     = "ChangeMe123!"
ssh_public_keys = [] # e.g. ["ssh-ed25519 AAAA... user@host"]

# --- Size (default for all VMs) ---------------------------------------
cpu       = 2
memory_mb = 4096
disk_gb   = 60

# --- Ansible (ansible-role-kubernetes) ----------------------------------------
# The inventory is always written to .ansible/inventory.yml. Set run_ansible =
# true to install the role and run it right after the VMs are created.
run_ansible                     = false
# Key for Ansible (its public key must be in ssh_public_keys). Without it the
# password is used, which requires sshpass.
# ansible_ssh_private_key_file  = "~/.ssh/id_ed25519"
ansible_role_version            = "v2.0.0"
kubernetes_api_vip              = "192.168.80.100" # free IP, not used by any VM
kubernetes_keepalived_auth_pass = "k8s-vip1" # at most 8 characters
# ansible_extra_vars = { kubernetes_observability_enabled = true }
