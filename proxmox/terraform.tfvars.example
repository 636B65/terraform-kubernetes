# Copy to terraform.tfvars and fill in.

# --- Proxmox -----------------------------------------------------------------
proxmox_endpoint  = "https://pve.lab.local:8006/"
proxmox_api_token = "root@pam!terraform=00000000-0000-0000-0000-000000000000"
# or: proxmox_username = "root@pam" and proxmox_password = "..."
proxmox_ssh_username = "root"
proxmox_ssh_password = "node-root-password" # or proxmox_ssh_agent = true

proxmox_node       = "pve"
vm_datastore       = "local-lvm"
image_datastore    = "local"
snippets_datastore = "local" # must have the "Snippets" content type enabled
network_bridge     = "vmbr0"
vm_id_start        = 9101

# --- Network ---------------------------------------------------------------
vms = {
  "ubuntu-01" = { ip = "192.168.1.101" }
  "ubuntu-02" = { ip = "192.168.1.102" }
  "ubuntu-03" = { ip = "192.168.1.103" }
  "ubuntu-04" = { ip = "192.168.1.104" }
  "ubuntu-05" = { ip = "192.168.1.105" }
  # Example of a per-VM override:
  "ubuntu-06" = { ip = "192.168.1.106", cpu = 4, memory_mb = 8192, disk_gb = 80 }
}
ip_prefix_length = 24
gateway          = "192.168.1.1"
dns_servers      = ["192.168.1.1", "1.1.1.1"]
dns_domain       = "lab.local"

# --- Login (SSH is always enabled with password) ----------------------
vm_username     = "ubuntu"
vm_password     = "ChangeMe123!"
ssh_public_keys = [] # e.g. ["ssh-ed25519 AAAA... user@host"]

# --- Size (default for all VMs) ---------------------------------------
cpu       = 2
memory_mb = 4096
disk_gb   = 40
