# Copy to terraform.tfvars and fill in.
# Use forward slashes (/) in paths, also on Windows.

# --- VirtualBox ---------------------------------------------------------------
vm_directory = "C:/VMs/virtualbox" # OVA download and cloud-init seed ISOs
# ubuntu_ova = "C:/Downloads/ubuntu-26.04-server-cloudimg-amd64.ova" # skip the download
# vboxmanage_path = "C:/Program Files/Oracle/VirtualBox/VBoxManage.exe"

# bridged puts the VMs on your LAN (they need internet access for Kubernetes).
# network_name is the host adapter: "eth0"/"en0", or on Windows its full name
# as listed by: VBoxManage list bridgedifs
network_type = "bridged"
network_name = "Intel(R) Ethernet Connection (7) I219-V"
start_gui    = false

# --- Network ---------------------------------------------------------------
vms = {
  "kube-cp01" = { ip = "192.168.1.101", role = "control_plane" }
  "kube-cp02" = { ip = "192.168.1.102", role = "control_plane" }
  "kube-cp03" = { ip = "192.168.1.103", role = "control_plane" }
  "kube-wl01" = { ip = "192.168.1.111", role = "worker" }
  "kube-wl02" = { ip = "192.168.1.112", role = "worker" }
  # Example of a per-VM override:
  "kube-wl03" = { ip = "192.168.1.113", role = "worker", cpu = 4, memory_mb = 8192, disk_gb = 100 }
}
ip_prefix_length = 24
gateway          = "192.168.1.1"
dns_servers      = ["192.168.1.1", "1.1.1.1"]
dns_domain       = "lab.local"

# --- Login (SSH is always enabled with password) ----------------------
vm_username     = "ubuntu"
vm_password     = "ChangeMe123!"
ssh_public_keys = [] # e.g. ["ssh-ed25519 AAAA... user@host"]

# --- Size (default for all VMs) ---------------------------------------
cpu       = 2
memory_mb = 4096
disk_gb   = 60

# --- Ansible (ansible-role-kubernetes) ----------------------------------------
# The inventory is always written to .ansible/inventory.yml. Set run_ansible =
# true to install the role and run it right after the VMs are created.
run_ansible                     = false
# Key for Ansible (its public key must be in ssh_public_keys). Without it the
# password is used, which requires sshpass.
# ansible_ssh_private_key_file  = "~/.ssh/id_ed25519"
ansible_role_version            = "v3.4.0"
kubernetes_api_vip              = "192.168.1.100" # free IP, not used by any VM
kubernetes_keepalived_auth_pass = "k8s-vip1" # at most 8 characters
# ansible_extra_vars = { kubernetes_observability_enabled = true }

# --- Offline / air-gapped (see README "Offline (air-gapped) deployment") -------
# Stage a bundle on an online cluster (needs run_ansible = true):
# stage_offline_bundle = true
# offline_bundle       = "~/kubernetes-offline.tar"
# ...or install from it on an offline network:
# offline        = true
# offline_bundle = "~/kubernetes-offline.tar"
# ntp_servers    = ["10.0.0.5"]
# apt_mirror     = "http://mirror.lab.local/ubuntu" # optional internal mirror

# --- IPv6 and a second NIC (see README "Networking") ---------------------------
# Per VM: ipv6 = "2001:db8::101", secondary_ip = "10.10.0.101" in vms.
# ipv6_gateway            = "2001:db8::1"
# secondary_prefix_length = 24
# secondary_network_type = "hostonly"
# secondary_network_name = "vboxnet0"

# --- Image verification -----------------------------------------------------------
# ubuntu_image_sha256 = "..." # default: looked up in SHA256SUMS for a URL

# --- Cluster operations (need run_ansible = true) ---------------------------------
# remove_nodes       = ["kube-wl03"] # drain + remove; delete from vms in a later apply
# kubernetes_upgrade = true          # rolling upgrade when the role version changes
# ansible_extra_vars = { kubernetes_ingress_enabled = true, kubernetes_cert_manager_enabled = true, kubernetes_argocd_enabled = true }
# velero = { enabled = true, bucket = "velero", s3_url = "http://minio.lab.local:9000", access_key = "velero", secret_key = "..." }
